{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Module */
    "module": "CommonJS",
    "moduleResolution": "node",

    /* Environment */
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/shared/**/*.ts",
    "src/features/**/*.ts",
    "src/app/cli/**/*.ts"
  ]
}

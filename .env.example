# MCP Server API Keys
# Copy this file to .env and fill in your actual keys

# Context7 MCP Server
CONTEXT7_API_KEY=your_context7_api_key_here

# GitHub MCP Server
GITHUB_MCP_PAT=your_github_personal_access_token_here

# n8n MCP Server
N8N_API_KEY=your_n8n_api_key_here
N8N_API_URL=your_n8n_instance_url_here

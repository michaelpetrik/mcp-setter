{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Output */
    "outDir": "./dist-electron",
    "noEmit": false,

    /* Module */
    "module": "CommonJS",
    "moduleResolution": "node",

    /* Environment */
    "lib": ["ES2022"],
    "types": ["node", "electron"]
  },
  "include": [
    "src/app/electron/**/*.ts",
    "electron/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/app/electron/renderer/**/*"
  ]
}
